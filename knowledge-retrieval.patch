@@ -0,0 +1,209 @@
+"""Builds and updates the knowledge index from the approved folders.
+
+Only folders listed under `knowledge.folders` in the config are read. For each
+supported file the indexer reads the text, splits it into chunks, asks the
+embedding model on the Ollama server for each chunk's embedding, and saves it
+all with KnowledgeStore. Running it again only redoes files that changed, and
+drops files that were deleted or whose folder was removed from the config.
+"""
+
+import hashlib
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Callable
+
+from app.config import ROOT
+from retrieval.chunker import chunk_text
+from retrieval.readers import DOCUMENT_EXTENSIONS, TEXT_EXTENSIONS, ReadError, read_document
+from retrieval.store import KnowledgeStore, NewChunk
+
+# Folders that are never worth indexing, wherever they appear.
+SKIP_DIRS = {"__pycache__", "node_modules", "venv", "env", "site-packages", "dist", "build"}
+
+# nomic-embed-text was trained with these labels in front of the text and works
+# best with them. Other models: set the prefixes in the config (often empty).
+KNOWN_PREFIXES = {
+    "nomic-embed-text": ("search_document: ", "search_query: "),
+    # Qwen3-Embedding wants a one-line task description before questions only.
+    "qwen3-embedding": ("", "Instruct: Given a question, retrieve passages from the "
+                            "user's documents that answer it\nQuery: "),
+}
+
+
+@dataclass
+class KnowledgeSettings:
+    folders: list[Path]
+    database: Path
+    embedding_model: str = "nomic-embed-text"
+    document_prefix: str = ""
+    query_prefix: str = ""
+    chunk_size: int = 1000
+    chunk_overlap: int = 150
+    batch_size: int = 16
+    max_file_mb: float = 20
+    extensions: set[str] = field(default_factory=lambda: TEXT_EXTENSIONS | DOCUMENT_EXTENSIONS)
+    top_k: int = 4
+    min_score: float = 0.5
+    use_in_chat: bool = True
+
+    @classmethod
+    def from_config(cls, config: dict) -> "KnowledgeSettings":
+        k = config.get("knowledge") or {}
+        model = k.get("embedding_model") or "nomic-embed-text"
+        default_doc, default_query = KNOWN_PREFIXES.get(model.split(":")[0], ("", ""))
+        extensions = k.get("extensions")
+        return cls(
+            folders=[resolve(f) for f in (k.get("folders") or ["knowledge"])],
+            database=resolve(k.get("database") or "data/indexes/knowledge.db"),
+            embedding_model=model,
+            document_prefix=_or(k.get("document_prefix"), default_doc),
+            query_prefix=_or(k.get("query_prefix"), default_query),
+            chunk_size=int(k.get("chunk_size", 1000)),
+            chunk_overlap=int(k.get("chunk_overlap", 150)),
+            batch_size=int(k.get("batch_size", 16)),
+            max_file_mb=float(k.get("max_file_mb", 20)),
+            extensions={e.lower() if e.startswith(".") else "." + e.lower() for e in extensions}
+            if extensions else TEXT_EXTENSIONS | DOCUMENT_EXTENSIONS,
+            top_k=int(k.get("top_k", 4)),
+            min_score=float(k.get("min_score", 0.5)),
+            use_in_chat=bool(k.get("use_in_chat", True)),
+        )
+
+
+def _or(value, default):
+    return default if value is None else value
+
+
+def resolve(path: str | Path) -> Path:
+    """A relative path in the config is inside the local-ai folder."""
+    path = Path(path).expanduser()
+    return (path if path.is_absolute() else ROOT / path).resolve()
+
+
+def display_path(path: Path, folder: Path) -> str:
+    """The folder's name plus the path inside it, e.g. knowledge/notes/setup.md"""
+    return (Path(folder.name) / path.relative_to(folder)).as_posix()
+
+
+def location(start: int, end: int, unit: str, page: int | None) -> str:
+    if page is not None:
+        return f"page {page}"
+    label = unit if start != end else unit.rstrip("s")
+    return f"{label} {start}-{end}" if start != end else f"{label} {start}"
+
+
+@dataclass
+class IndexReport:
+    added: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    unchanged: int = 0
+    removed: list[str] = field(default_factory=list)
+    skipped: list[tuple[str, str]] = field(default_factory=list)  # (file, reason)
+    missing_folders: list[str] = field(default_factory=list)
+    chunks: int = 0
+    seconds: float = 0.0
+
+
+class Indexer:
+    def __init__(self, client, store: KnowledgeStore, settings: KnowledgeSettings,
+                 progress: Callable[[str], None] | None = None):
+        self.client = client  # anything with embed(model, texts), normally OllamaClient
+        self.store = store
+        self.settings = settings
+        self.progress = progress or (lambda message: None)
+
+    def run(self, rebuild: bool = False) -> IndexReport:
+        report = IndexReport()
+        started = time.monotonic()
+        s = self.settings
+
+        # Vectors from different models don't mix, so a new model means starting over.
+        built_with = self.store.get_setting("embedding_model")
+        if rebuild or (built_with and built_with != s.embedding_model):
+            if built_with and built_with != s.embedding_model:
+                self.progress(f"Embedding model changed from {built_with} to "
+                              f"{s.embedding_model}, so everything is re-indexed.")
+            self.store.clear()
+        self.store.set_setting("embedding_model", s.embedding_model)
+
+        stored = self.store.files()
+        seen: set[str] = set()
+        missing: list[Path] = []
+        for folder in s.folders:
+            if not folder.is_dir():
+                missing.append(folder)
+                report.missing_folders.append(str(folder))
+                continue
+            for path in self._files_in(folder):
+                key = str(path)
+                if key in seen:
+                    continue  # the same file through two overlapping folders
+                seen.add(key)
+                self._index_file(path, folder, stored.get(key), report)
+
+        # Forget files that are gone. A folder that's missing (say, an unplugged
+        # drive) keeps its entries rather than being wiped.
+        for key, old in stored.items():
+            if key in seen or any(Path(key).is_relative_to(m) for m in missing):
+                continue
+            self.store.remove_file(key)
+            report.removed.append(key)
+
+        report.seconds = time.monotonic() - started
+        return report
+
+    def _files_in(self, folder: Path):
+        for path in sorted(folder.rglob("*")):
+            parts = path.relative_to(folder).parts
+            # Skip hidden files and folders (.git, .venv, ...) and known clutter.
+            if any(p.startswith(".") or p in SKIP_DIRS for p in parts):
+                continue
+            if path.is_symlink():
+                # Don't follow links that lead outside the approved folder.
+                if not path.resolve().is_relative_to(folder):
+                    continue
+            if path.is_file() and path.suffix.lower() in self.settings.extensions:
+                yield path.resolve() if path.is_symlink() else path
+
+    def _index_file(self, path: Path, folder: Path, old, report: IndexReport) -> None:
+        s = self.settings
+        shown = display_path(path, folder) if path.is_relative_to(folder) else str(path)
+        try:
+            stat = path.stat()
+            if stat.st_size > s.max_file_mb * 1024 * 1024:
+                raise ReadError(f"larger than {s.max_file_mb:g} MB (knowledge.max_file_mb)")
+            # Same size and modified time: assume unchanged without reading it.
+            if old and old.size == stat.st_size and old.mtime == stat.st_mtime:
+                report.unchanged += 1
+                return
+            data = path.read_bytes()
+            digest = hashlib.sha256(data).hexdigest()
+            if old and old.sha256 == digest:
+                self.store.touch_file(old.id, stat.st_size, stat.st_mtime)
+                report.unchanged += 1
+                return
+
+            started = time.monotonic()
+            pieces = []
+            for section in read_document(path):
+                for c in chunk_text(section.text, s.chunk_size, s.chunk_overlap):
+                    pieces.append((location(c.start_line, c.end_line, section.unit, section.page),
+                                   c.text))
+            if not pieces:
+                raise ReadError("no text found")
+            vectors = []
+            for i in range(0, len(pieces), s.batch_size):
+                batch = [s.document_prefix + text for _, text in pieces[i:i + s.batch_size]]
+                vectors.extend(self.client.embed(s.embedding_model, batch))
+        except (ReadError, OSError) as e:
+            report.skipped.append((shown, str(e)))
+            self.progress(f"  skipped {shown}: {e}")
+            return
+
+        chunks = [NewChunk(loc, text, vec) for (loc, text), vec in zip(pieces, vectors)]
+        self.store.replace_file(str(path), shown, str(folder), stat.st_size, stat.st_mtime,
+                                digest, chunks)
+        (report.updated if old else report.added).append(shown)
+        report.chunks += len(chunks)
+        self.progress(f"  {shown}: {len(chunks)} chunks in {time.monotonic() - started:.1f}s")
diff --git a/retrieval/readers.py b/retrieval/readers.py
new file mode 100644
index 0000000..97f5596
--- /dev/null
+++ b/retrieval/readers.py
@@ -0,0 +1,98 @@
+"""Reads the text out of a document so it can be split into chunks.
+
+Plain text, Markdown and code are read directly. PDF needs `pypdf` and Word
+(.docx) needs `python-docx`; both are in requirements.txt. Each reader returns
+a list of Sections. A text file is one section; a PDF has one per page, so
+answers can point to the page a passage came from.
+"""
+
+import logging
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class ReadError(Exception):
+    """The file can't be indexed. The message says why, for the index report."""
+
+
+@dataclass
+class Section:
+    text: str
+    page: int | None = None  # PDF page number, starting at 1
+    unit: str = "lines"      # what the chunker's line numbers count: "lines" or "paragraphs"
+
+
+TEXT_EXTENSIONS = {
+    ".txt", ".md", ".markdown", ".rst", ".log", ".csv",
+    ".py", ".js", ".ts", ".jsx", ".tsx", ".java", ".c", ".h", ".cpp", ".hpp", ".cs",
+    ".go", ".rs", ".rb", ".php", ".sql", ".sh", ".ps1", ".bat",
+    ".json", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".xml", ".html", ".css",
+}
+DOCUMENT_EXTENSIONS = {".pdf", ".docx"}
+
+
+def read_document(path: Path) -> list[Section]:
+    suffix = path.suffix.lower()
+    if suffix == ".pdf":
+        return read_pdf(path)
+    if suffix == ".docx":
+        return read_docx(path)
+    return read_text(path)
+
+
+def read_text(path: Path) -> list[Section]:
+    data = path.read_bytes()
+    if b"\x00" in data[:8192]:
+        raise ReadError("looks like a binary file")
+    # utf-8-sig drops the byte-order mark some Windows editors add.
+    return [Section(data.decode("utf-8-sig", errors="replace"))]
+
+
+def read_pdf(path: Path) -> list[Section]:
+    try:
+        from pypdf import PdfReader
+    except ImportError:
+        raise ReadError("needs pypdf (pip install -r requirements.txt)") from None
+    # pypdf logs a warning for every small flaw it works around; the index
+    # report already says when a file couldn't be read.
+    logging.getLogger("pypdf").setLevel(logging.ERROR)
+    try:
+        reader = PdfReader(path)
+        if reader.is_encrypted:
+            raise ReadError("the PDF is password protected")
+        sections = []
+        for number, page in enumerate(reader.pages, start=1):
+            text = (page.extract_text() or "").strip()
+            if text:
+                sections.append(Section(text, page=number))
+    except ReadError:
+        raise
+    except Exception as e:  # pypdf raises many kinds for a damaged file
+        raise ReadError(f"couldn't read the PDF ({e})") from e
+    if not sections:
+        # Usually a scanned document: pages are pictures, with no text to extract.
+        raise ReadError("no text found (a scanned PDF needs OCR, which isn't supported yet)")
+    return sections
+
+
+def read_docx(path: Path) -> list[Section]:
+    try:
+        import docx
+    except ImportError:
+        raise ReadError("needs python-docx (pip install -r requirements.txt)") from None
+    try:
+        document = docx.Document(str(path))
+    except Exception as e:  # python-docx raises several kinds for a damaged file
+        raise ReadError(f"couldn't read the Word file ({e})") from e
+    # One line per paragraph, so chunk locations can say "paragraphs 4-9".
+    # Table rows become lines too, with cells separated by " | ".
+    lines = []
+    for block in document.iter_inner_content():
+        if isinstance(block, docx.table.Table):
+            for row in block.rows:
+                cells = [c.text.strip() for c in row.cells]
+                lines.append(" | ".join(cells))
+            lines.append("")
+        else:
+            lines.append(block.text)
+    return [Section("\n".join(lines), unit="paragraphs")]
diff --git a/retrieval/retriever.py b/retrieval/retriever.py
new file mode 100644
index 0000000..d35f7ec
--- /dev/null
+++ b/retrieval/retriever.py
@@ -0,0 +1,42 @@
+"""Finds the passages that best match a question and formats them for the model.
+
+The question is embedded with the same model as the documents, compared with
+every stored chunk, and the closest ones (above knowledge.min_score) are pasted
+into the prompt as numbered sources. The model is asked to cite them like [1],
+but the app also prints the source list itself, so you can always see which
+files informed an answer even if a small model forgets to cite.
+"""
+
+from retrieval.indexer import KnowledgeSettings
+from retrieval.store import Hit, KnowledgeStore
+
+INSTRUCTIONS = (
+    "Below are numbered passages from the user's local documents, found by searching "
+    "for their question. Use them if they help, and cite the ones you use like [1]. "
+    "If they don't contain the answer, say so and answer from general knowledge, "
+    "making clear which parts aren't from the documents."
+)
+
+
+class Retriever:
+    def __init__(self, client, store: KnowledgeStore, settings: KnowledgeSettings):
+        self.client = client
+        self.store = store
+        self.settings = settings
+
+    def search(self, question: str) -> list[Hit]:
+        s = self.settings
+        [vector] = self.client.embed(s.embedding_model, [s.query_prefix + question])
+        return self.store.search(vector, top_k=s.top_k, min_score=s.min_score)
+
+
+def build_prompt(question: str, hits: list[Hit]) -> str:
+    """The user message sent to the model: sources first, then the question."""
+    if not hits:
+        return question
+    blocks = [f"[{i}] {hit.reference}\n{hit.text}" for i, hit in enumerate(hits, start=1)]
+    return (
+        INSTRUCTIONS
+        + "\n\n<sources>\n" + "\n\n".join(blocks) + "\n</sources>\n\n"
+        + "Question: " + question
+    )
diff --git a/retrieval/store.py b/retrieval/store.py
new file mode 100644
index 0000000..3865cfc
--- /dev/null
+++ b/retrieval/store.py
@@ -0,0 +1,204 @@
+"""Keeps indexed documents, their chunks and the chunks' embeddings in SQLite.
+
+An embedding is a list of numbers (768 for nomic-embed-text) that describes
+what a piece of text is about. Texts with similar meaning get similar lists,
+so finding passages that answer a question is a matter of finding the stored
+lists closest to the question's list.
+
+The lists are stored as raw bytes (4 bytes per number). Each one is scaled to
+length 1 before saving, which makes "how similar" a plain dot product: the
+cosine similarity, from about 0 (unrelated) to 1 (same meaning). Search checks
+every chunk, which takes well under a second for a few thousand chunks and
+needs no extra software. A dedicated vector database can replace this class
+later if the collection grows much larger.
+"""
+
+import math
+import sqlite3
+from array import array
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS files (
+    id          INTEGER PRIMARY KEY AUTOINCREMENT,
+    path        TEXT NOT NULL UNIQUE,  -- full path on this computer
+    display     TEXT NOT NULL,         -- shorter path shown in source lists
+    folder      TEXT NOT NULL,         -- the approved folder it was found in
+    size        INTEGER NOT NULL,
+    mtime       REAL NOT NULL,
+    sha256      TEXT NOT NULL,
+    indexed_at  TEXT NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS chunks (
+    id         INTEGER PRIMARY KEY AUTOINCREMENT,
+    file_id    INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+    position   INTEGER NOT NULL,       -- order within the file
+    location   TEXT NOT NULL,          -- e.g. "lines 12-30" or "page 3"
+    text       TEXT NOT NULL,
+    embedding  BLOB NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS chunks_by_file ON chunks (file_id, position);
+
+-- Which embedding model built the index. Vectors from different models
+-- can't be compared, so changing the model means re-embedding everything.
+CREATE TABLE IF NOT EXISTS settings (
+    key   TEXT PRIMARY KEY,
+    value TEXT NOT NULL
+);
+"""
+
+
+@dataclass
+class StoredFile:
+    id: int
+    path: str
+    folder: str
+    size: int
+    mtime: float
+    sha256: str
+
+
+@dataclass
+class NewChunk:
+    location: str
+    text: str
+    embedding: list[float]
+
+
+@dataclass
+class Hit:
+    """A chunk found by a search, with how similar it is to the question (0-1)."""
+    display: str
+    location: str
+    text: str
+    score: float
+
+    @property
+    def reference(self) -> str:
+        return f"{self.display} ({self.location})"
+
+
+def normalize(vector: list[float]) -> list[float]:
+    length = math.sqrt(sum(x * x for x in vector))
+    if length == 0:
+        return list(vector)
+    return [x / length for x in vector]
+
+
+def to_bytes(vector: list[float]) -> bytes:
+    return array("f", normalize(vector)).tobytes()
+
+
+def from_bytes(blob: bytes) -> array:
+    vector = array("f")
+    vector.frombytes(blob)
+    return vector
+
+
+class KnowledgeStore:
+    def __init__(self, path: str | Path):
+        """Open (or create) the index. Pass ":memory:" for a throwaway one."""
+        if str(path) != ":memory:":
+            Path(path).parent.mkdir(parents=True, exist_ok=True)
+        self.path = str(path)
+        self.db = sqlite3.connect(self.path)
+        self.db.row_factory = sqlite3.Row
+        self.db.execute("PRAGMA foreign_keys = ON")
+        self.db.executescript(SCHEMA)
+        self._vectors = None  # search cache, rebuilt after any change
+
+    def close(self) -> None:
+        self.db.close()
+
+    # Settings
+
+    def get_setting(self, key: str) -> str | None:
+        row = self.db.execute("SELECT value FROM settings WHERE key = ?", (key,)).fetchone()
+        return row["value"] if row else None
+
+    def set_setting(self, key: str, value: str) -> None:
+        with self.db:
+            self.db.execute(
+                "INSERT INTO settings (key, value) VALUES (?, ?)"
+                " ON CONFLICT(key) DO UPDATE SET value = excluded.value",
+                (key, value),
+            )
+
+    # Files and chunks
+
+    def files(self) -> dict[str, StoredFile]:
+        rows = self.db.execute("SELECT id, path, folder, size, mtime, sha256 FROM files")
+        return {r["path"]: StoredFile(*r) for r in rows}
+
+    def touch_file(self, file_id: int, size: int, mtime: float) -> None:
+        """Record a new modified time for a file whose content didn't change."""
+        with self.db:
+            self.db.execute("UPDATE files SET size = ?, mtime = ? WHERE id = ?",
+                            (size, mtime, file_id))
+
+    def replace_file(self, path: str, display: str, folder: str, size: int, mtime: float,
+                     sha256: str, chunks: list[NewChunk]) -> None:
+        """Save a file and its chunks, replacing any older version (all or nothing)."""
+        stamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
+        with self.db:
+            self.db.execute("DELETE FROM files WHERE path = ?", (path,))
+            cur = self.db.execute(
+                "INSERT INTO files (path, display, folder, size, mtime, sha256, indexed_at)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?)",
+                (path, display, folder, size, mtime, sha256, stamp),
+            )
+            self.db.executemany(
+                "INSERT INTO chunks (file_id, position, location, text, embedding)"
+                " VALUES (?, ?, ?, ?, ?)",
+                [(cur.lastrowid, i, c.location, c.text, to_bytes(c.embedding))
+                 for i, c in enumerate(chunks)],
+            )
+        self._vectors = None
+
+    def remove_file(self, path: str) -> None:
+        with self.db:
+            self.db.execute("DELETE FROM files WHERE path = ?", (path,))
+        self._vectors = None
+
+    def clear(self) -> None:
+        with self.db:
+            self.db.execute("DELETE FROM files")
+        self._vectors = None
+
+    def counts(self) -> tuple[int, int]:
+        """(number of files, number of chunks)"""
+        files = self.db.execute("SELECT COUNT(*) FROM files").fetchone()[0]
+        chunks = self.db.execute("SELECT COUNT(*) FROM chunks").fetchone()[0]
+        return files, chunks
+
+    # Search
+
+    def search(self, query: list[float], top_k: int = 4, min_score: float = 0.0) -> list[Hit]:
+        """The top_k chunks most similar to the query vector, best first."""
+        if self._vectors is None:
+            self._vectors = [
+                (r["id"], from_bytes(r["embedding"]))
+                for r in self.db.execute("SELECT id, embedding FROM chunks")
+            ]
+        q = normalize(query)
+        scored = []
+        for chunk_id, vector in self._vectors:
+            if len(vector) != len(q):
+                continue  # from a different model; skipped until the next index
+            score = sum(a * b for a, b in zip(q, vector))
+            if score >= min_score:
+                scored.append((score, chunk_id))
+        scored.sort(reverse=True)
+        hits = []
+        for score, chunk_id in scored[:top_k]:
+            row = self.db.execute(
+                "SELECT f.display, c.location, c.text FROM chunks c"
+                " JOIN files f ON f.id = c.file_id WHERE c.id = ?",
+                (chunk_id,),
+            ).fetchone()
+            hits.append(Hit(row["display"], row["location"], row["text"], round(score, 3)))
+        return hits
